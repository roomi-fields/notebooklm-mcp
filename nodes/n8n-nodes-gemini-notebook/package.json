{
  "name": "n8n-nodes-gemini-notebook",
  "version": "4.10.0",
  "description": "n8n community node for Google Gemini Notebook (formerly NotebookLM): citation-backed answers, passage retrieval, Studio generation — all 59 operations of a local notebooklm-mcp server.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "notebooklm",
    "gemini-notebook",
    "google-notebooklm",
    "citations",
    "rag"
  ],
  "license": "MIT",
  "homepage": "https://notebooklm.roomi-fields.com/",
  "author": {
    "name": "Roomi Fields"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roomi-fields/notebooklm-mcp.git",
    "directory": "nodes/n8n-nodes-gemini-notebook"
  },
  "main": "index.js",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc && node copy-icons.mjs",
    "dev": "tsc --watch"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NotebookLmApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/NotebookLm/NotebookLm.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
