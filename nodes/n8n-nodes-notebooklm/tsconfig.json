{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "useUnknownInCatchVariables": false
  },
  "include": ["credentials/**/*.ts", "nodes/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
